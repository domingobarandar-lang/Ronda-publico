{
  "name": "rondas-qr",
  "version": "1.27.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "description": "Control de rondas de seguridad con QR — app del guardia + app del panel del administrador",
  "scripts": {
    "start": "node server.js",
    "seed": "node seed.js",
    "demo": "node seed.js --si-vacio && node server.js",
    "test": "node --test",
    "build:sentry": "esbuild scripts/sentry-entrada.js --bundle --minify --format=iife --target=es2017 --legal-comments=none --outfile=public/vendor/sentry.js"
  },
  "dependencies": {
    "@sentry/node": "^11.6.0",
    "docx": "^9.7.1",
    "express": "^4.21.2",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@sentry/browser": "^11.6.0",
    "esbuild": "^0.28.2"
  }
}
