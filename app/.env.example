# Puerto del servidor
PORT=3737

# ---- Base de datos (v1.17: SQLite) ----
# Vacío = data/rondas.sqlite. En Railway, sobre el volumen: /data/rondas.sqlite
# (si apunta a un .json, como hasta la v1.16, se usa rondas.sqlite en la misma
# carpeta y ese .json se importa solo la primera vez).
DB_PATH=

# ---- Respaldo diario de la base ----
# Foto diaria en <carpeta de la base>/respaldos/ (se guardan RESPALDO_CONSERVAR)
# y copia comprimida por correo a RESPALDO_TO con la cuenta de Gmail de abajo.
# El respaldo trae hashes de PIN, correos y GPS: RESPALDO_TO tiene que ser un
# buzón de la operación con verificación en dos pasos. Vacío = no sale copia
# fuera del servidor (el log lo avisa).
RESPALDO_TO=
RESPALDO_HORA=10
RESPALDO_CONSERVAR=14
RESPALDO_CORREO_CADA_DIAS=1

# Los avisos de cierre de ronda quedan SIEMPRE en el panel (pestaña Avisos) y en
# la consola del servidor. Los canales que salen del servidor son dos y se
# configuran más abajo: el correo semanal (GMAIL_CLIENT_ID y compañía) y el
# push al teléfono del administrador (VAPID). El canal Telegram se eliminó en
# la v1.15.

# ---- Cuenta de fábrica (alta de condominios) ----
# La cuenta que da de alta condominios y cuentas de administrador desde /fabrica.
# Se crea sola al arrancar; si cambias el PIN acá, se actualiza al reiniciar (así
# se recupera el acceso sin tocar la base). Si dejas esto vacío, la pantalla de
# fábrica queda inaccesible y no se pueden crear condominios.
# El PIN debe tener 8 dígitos: es la llave de toda la operación.
FABRICA_USUARIO=
FABRICA_PIN=

# ---- Cuenta de panel con ACCESO TOTAL (la de la operación) ----
# Es la única cuenta de administrador que recorre TODOS los condominios con el
# selector del panel; cualquier otra cuenta de panel queda encerrada en el suyo.
# Se crea (o se actualiza) sola al arrancar: no se puede crear ni marcar desde
# ninguna pantalla. Cambiar el PIN acá lo actualiza en el siguiente reinicio.
# Si el usuario ya existe con otro rol (guardia, fábrica), no se toca y se
# avisa en la consola.
# ADMIN_TOTAL_PIN: 8 a 32 letras y números, con al menos una letra y un dígito.
#   Distingue mayúsculas. NUNCA lo escribas en git: ponlo en Railway o en tu
#   app/.env local (que no se versiona).
# ADMIN_TOTAL_CONDOMINIO: id del condominio "de casa" (en el que arranca el
#   panel). Si no existe, se usa el primero.
ADMIN_TOTAL_USUARIO=
ADMIN_TOTAL_NOMBRE=
ADMIN_TOTAL_PIN=
ADMIN_TOTAL_CONDOMINIO=

# ---- Verificación de presencia por GPS (CU-16 / CU-18) ----
# Solo aplica a los puntos a los que el administrador les fijó ubicación desde el
# panel ("📍 Fijar aquí"). Un punto sin ubicación fijada NO se verifica: así se
# deja marcar lo que está bajo techo, donde el GPS no llega.
# Todos estos valores viajan al teléfono en el paquete de rondas: cambiarlos acá
# alcanza, la app se alinea sola al actualizar rondas.

# Metros máximos entre el teléfono y el punto para poder marcar.
GPS_RADIO_M=20
# Techo de la imprecisión que se perdona, en metros (se SUMA al radio). Acá se
# comparan DOS medidas de GPS —la del punto, tomada por el admin, y la del
# teléfono ahora— y sus errores se suman: exigir 20 m clavados entre dos fixes de
# ±20 m es imposible de cumplir. El margen real es la suma de las dos
# imprecisiones declaradas, topada en este valor. 0 = radio estricto (v1.12).
GPS_MARGEN_MAX_M=40
# Peor precisión de fix que sirve para decidir. Un fix de WiFi o de antena
# declara ±300 m: con eso la distancia al punto es ruido y no se usa para nada.
GPS_PRECISION_MAX_M=100
# Precisión que se asume cuando la medida no la informó (puntos fijados antes de
# v1.13, cuando el panel guardaba la ubicación sin medir su calidad).
GPS_PRECISION_SUPUESTA_M=15
# Piso de la precisión declarada de un fix. Desde v1.14 el ± que manda el
# teléfono no lo dio el navegador: lo calcula la app promediando varias lecturas.
# Un ±0 m no es un fix perfecto, es un error de cálculo, y aceptarlo aflojaría el
# margen de todas las marcas del sistema. Subirlo solo si el parque de teléfonos
# resulta ser más mentiroso de lo esperado.
GPS_PRECISION_MIN_M=3
# Antigüedad máxima del fix GPS para poder marcar (ms).
GPS_FRESCO_MS=20000
# 1 = la marca lejos o sin GPS se RECHAZA (no se puede escanear el QR de lejos).
# 0 = marcha atrás: se acepta y solo queda observada en el informe (como v1.8).
GPS_BLOQUEA=1

# Puntos bajo techo (subterráneos, salas de calderas, interiores): el admin fija
# la ENTRADA del recinto con "🏠 Fijar entrada" y el guardia puede marcar si pasó
# por ahí hace poco. Estos dos son los defaults; cada punto puede tener su propio
# radio y ventana desde el panel ("Ajustar").
GPS_ANCLA_RADIO_M=40
GPS_ANCLA_VENTANA_MIN=15

# ---- Correo del informe semanal (opcional) ----
# Se manda con la API de Gmail (HTTPS), NO por SMTP: Railway bloquea los
# puertos SMTP (465/587 dan timeout). El correo sale de verdad desde la
# cuenta de Gmail configurada, no desde un tercero.
#
# Las 3 credenciales de abajo salen de un OAuth client "Desktop app" en
# https://console.cloud.google.com/ (con la Gmail API habilitada). El
# GMAIL_REFRESH_TOKEN se obtiene UNA VEZ, corriendo en tu compu (no en
# Railway): `node scripts/obtener-refresh-token.js` — instrucciones dentro del
# script. Con las 3 puestas, el server manda el informe semanal automáticamente
# (día/hora abajo). Si falta alguna, el envío queda en pausa y no rompe nada.
#
# A QUIÉN le llega NO se configura acá: cada administrador guarda su correo en el
# panel (pestaña Avisos) y queda en su condominio. El que administra varios pone
# el mismo correo en cada uno y recibe UN correo con todos los informes adjuntos.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Remitente. Tiene que ser la MISMA cuenta dueña del refresh token (Gmail
# rechaza mandar "de" una cuenta distinta a la autenticada).
GMAIL_FROM=Rondas QR <tu-cuenta@gmail.com>
# Respaldo: destinatario de los condominios que todavía no cargaron su correo en
# el panel. Vacío = esos condominios simplemente no se envían.
INFORME_TO=
# Cuándo mandarlo (hora de Chile): 1=lunes ... y la hora en formato 24h.
INFORME_DIA=1
INFORME_HORA=8
# Lista blanca opcional (ids separados por coma). Vacío = todos los condominios
# que tengan correo cargado. Solo para dejar fuera alguno a propósito.
INFORME_CONDOMINIOS=
