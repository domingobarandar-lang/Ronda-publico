# Puerto del servidor
PORT=3737

# true  → los avisos al administrador NO salen a Telegram: quedan en el panel
#         (pestaña Avisos) y en la consola. Ideal para demo y QA.
# false → los avisos salen por Telegram (requiere token y chat_id configurado
#         en el panel del condominio).
MOCK=true

# Token del bot de Telegram que envía los informes a los administradores.
# Solo se usa con MOCK=false.
TELEGRAM_BOT_TOKEN=

# ---- Verificación de presencia por GPS (CU-16 / CU-18) ----
# Solo aplica a los puntos a los que el administrador les fijó ubicación desde el
# panel ("📍 Fijar aquí"). Un punto sin ubicación fijada NO se verifica: así se
# deja marcar lo que está bajo techo, donde el GPS no llega.
# Los cuatro valores viajan al teléfono en el paquete de rondas: cambiarlos acá
# alcanza, la app se alinea sola al actualizar rondas.

# Metros máximos entre el teléfono y el punto para poder marcar.
GPS_RADIO_M=20
# Cuánta imprecisión declarada por el GPS se perdona (se SUMA al radio).
# 0 = radio estricto. Subirlo si en terreno hay muchos rechazos legítimos.
GPS_MARGEN_MAX_M=0
# Antigüedad máxima del fix GPS para poder marcar (ms).
GPS_FRESCO_MS=20000
# 1 = la marca lejos o sin GPS se RECHAZA (no se puede escanear el QR de lejos).
# 0 = marcha atrás: se acepta y solo queda observada en el informe (como v1.8).
GPS_BLOQUEA=1

# Puntos bajo techo (subterráneos, salas de calderas, interiores): el admin fija
# la ENTRADA del recinto con "🏠 Fijar entrada" y el guardia puede marcar si pasó
# por ahí hace poco. Estos dos son los defaults; cada punto puede tener su propio
# radio y ventana desde el panel ("Ajustar").
GPS_ANCLA_RADIO_M=40
GPS_ANCLA_VENTANA_MIN=15

# ---- Correo del informe semanal (opcional) ----
# Se manda con Resend (API HTTP), NO por SMTP: Railway bloquea los puertos SMTP.
# Con la API key puesta, el server manda el informe semanal automáticamente
# (día/hora abajo). Sin ella, el envío queda en pausa y no rompe nada.
#
# A QUIÉN le llega NO se configura acá: cada administrador guarda su correo en el
# panel (pestaña Avisos) y queda en su condominio. El que administra varios pone
# el mismo correo en cada uno y recibe UN correo con todos los informes adjuntos.
RESEND_API_KEY=
# Remitente. Con el dominio de prueba de Resend usar onboarding@resend.dev, pero
# OJO: ese dominio solo entrega al correo con que te registraste en Resend. Para
# escribirle a administradores externos hay que verificar un dominio propio.
INFORME_FROM=Rondas QR <onboarding@resend.dev>
# Respaldo: destinatario de los condominios que todavía no cargaron su correo en
# el panel. Vacío = esos condominios simplemente no se envían.
INFORME_TO=
# Cuándo mandarlo (hora de Chile): 1=lunes ... y la hora en formato 24h.
INFORME_DIA=1
INFORME_HORA=8
# Lista blanca opcional (ids separados por coma). Vacío = todos los condominios
# que tengan correo cargado. Solo para dejar fuera alguno a propósito.
INFORME_CONDOMINIOS=
